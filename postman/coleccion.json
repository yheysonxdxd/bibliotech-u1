    {
      "name": "Libros (RN-01)",
      "item": [
        {
          "name": "01 Listar libros (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cuerpo: arreglo con estado calculado', () => {",
                  "  const libros = pm.response.json();",
                  "  pm.expect(libros).to.be.an('array');",
                  "  libros.forEach(l => pm.expect(['DISPONIBLE', 'NO_DISPONIBLE']).to.include(l.estado));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros"
              ]
            }
          }
        },
        {
          "name": "02 Registrar libro válido (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const isbn = '978' + String(Date.now()).slice(-10);",
                  "pm.collectionVariables.set('isbn', isbn);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "const libro = pm.response.json();",
                  "pm.test('Cuerpo: id, ISBN y estado DISPONIBLE', () => {",
                  "  pm.expect(libro.id).to.be.a('number');",
                  "  pm.expect(libro.isbn).to.eql(pm.collectionVariables.get('isbn'));",
                  "  pm.expect(libro.estado).to.eql('DISPONIBLE');",
                  "});",
                  "pm.collectionVariables.set('libroId', libro.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{isbn}}\",\n  \"titulo\": \"Pruebas de Software\",\n  \"autor\": \"Glenford Myers\",\n  \"ejemplaresDisponibles\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
